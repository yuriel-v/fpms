# =============================================================================
# FPMS — Environment configuration (example)
# =============================================================================
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
#
# All cross-service configuration and secrets are provided here so that the
# database can later be pointed at an external instance via configuration only
# (change host/credentials below, optionally drop the `db` service) — no code
# changes required.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL database
# -----------------------------------------------------------------------------
# These credentials are consumed by the `db` service to initialize the cluster
# and by the backend to connect. To use an EXTERNAL database instead, point
# POSTGRES_HOST/POSTGRES_PORT at it (and you may remove the `db` service).
POSTGRES_DB=fpms
POSTGRES_USER=fpms
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full JDBC URL the backend uses to reach Postgres. Derived from the values
# above by default; override directly when targeting an external database.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fpms

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Port the backend listens on (inside the container and published to the host).
BACKEND_PORT=8080

# JWT signing secret — MUST be overridden with a strong random value per
# environment. Keep this out of version control.
JWT_SECRET=change-me-use-a-long-random-secret

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Port the frontend is published on.
FRONTEND_PORT=5173

# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8080
